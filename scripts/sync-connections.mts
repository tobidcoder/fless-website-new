// Regenerates src/lib/connections.generated.ts from the backend's package catalog.
//
// Run it from a checkout of getfless/backend-employees with dependencies installed,
// so its TypeScript sources resolve:
//   cd ../backend-employees
//   OUT=../fless-website-new/src/lib/connections.generated.ts \
//     node --import tsx ../fless-website-new/scripts/sync-connections.mts
import { execSync } from "node:child_process"
import { mkdirSync, rmSync, writeFileSync } from "node:fs"
import { dirname, resolve } from "node:path"

const backend = process.cwd()
const outFile = resolve(process.env.OUT ?? "../fless-website-new/src/lib/connections.generated.ts")
const { PACKAGE_CATALOG } = await import(`${backend}/packages/contracts/src/packages/index.ts`)
const commit = execSync("git rev-parse --short HEAD", { cwd: backend }).toString().trim()

// Website statuses. Unofficial partner integrations are excluded: Fless only lists
// connections that use the provider's official API.
const STATUS: Record<string, string> = {
  GA: "Available",
  BETA: "Beta",
  NEEDS_PROVIDER_APPROVAL: "Awaiting approval",
}

type Prop = { type?: string | string[]; description?: string; enum?: unknown[]; items?: { type?: string } }
type Action = {
  id: string; name: string; description: string; kind: string; risk: string; outward: boolean
  irreversible: boolean; spendsMoney?: boolean; defaultMode: string; status?: string
  input?: { properties?: Record<string, Prop>; required?: string[] }
}
type Entry = {
  id: string; displayName: string; status: string; category: string; description?: string
  auth: { type: string; docsUrl?: string }; actions: Action[]; triggers?: Array<{ id: string; name?: string; description?: string }>
}

const typeOf = (p: Prop) => {
  if (p.enum) return p.enum.map((v) => JSON.stringify(v)).join(" | ")
  const t = Array.isArray(p.type) ? p.type.join(" | ") : p.type ?? "object"
  return t === "array" ? `${p.items?.type ?? "object"}[]` : t
}

const rows = (PACKAGE_CATALOG as Entry[])
  .filter((p) => STATUS[p.status])
  .map((p) => ({
    id: p.id.replace(/^@fless\//, ""),
    name: p.displayName,
    status: STATUS[p.status],
    category: p.category,
    summary: p.description ?? "",
    actions: p.actions?.length ?? 0,
  }))

// One JSON file per package for the docs, loaded on demand so the page stays small.
const catalogDir = resolve(dirname(outFile), "../../public/catalog")
rmSync(catalogDir, { recursive: true, force: true })
mkdirSync(catalogDir, { recursive: true })
for (const p of (PACKAGE_CATALOG as Entry[]).filter((p) => STATUS[p.status])) {
  const slug = p.id.replace(/^@fless\//, "")
  writeFileSync(
    resolve(catalogDir, `${slug}.json`),
    JSON.stringify({
      id: slug,
      packageName: p.id,
      name: p.displayName,
      status: STATUS[p.status],
      category: p.category,
      summary: p.description ?? "",
      auth: { type: p.auth.type, docsUrl: p.auth.docsUrl ?? null },
      triggers: (p.triggers ?? []).map((t) => ({ id: t.id, name: t.name ?? t.id, description: t.description ?? "" })),
      actions: p.actions.map((a) => ({
        id: a.id,
        name: a.name,
        description: a.description,
        kind: a.kind,
        risk: a.risk,
        outward: a.outward,
        irreversible: a.irreversible,
        spendsMoney: Boolean(a.spendsMoney),
        defaultMode: a.defaultMode,
        status: a.status && STATUS[a.status] ? STATUS[a.status] : null,
        params: Object.entries(a.input?.properties ?? {}).map(([name, prop]) => ({
          name,
          type: typeOf(prop),
          required: (a.input?.required ?? []).includes(name),
          description: prop.description ?? "",
        })),
      })),
    })
  )
}

const out = `// Generated by scripts/sync-connections.mts from getfless/backend-employees@${commit}
// (packages/contracts PACKAGE_CATALOG). Do not edit by hand; re-run the script.

import type { Connection } from "@/lib/sdk"

export const CATALOG_COMMIT = "${commit}"

export const CONNECTIONS: Connection[] = ${JSON.stringify(rows, null, 2)}
`
writeFileSync(outFile, out)
console.log(`Wrote ${rows.length} connections from ${commit}`)
